{
  "name": "lazarus-core",
  "version": "2.1.0",
  "description": "Lazarus Core - Recover the Impossible",
  "main": "main/index.js",
  "homepage": "./",
  "author": {
    "name": "Lazarus Core Team"
  },
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:renderer\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "dev:renderer": "cd renderer && npm run dev",
    "build": "npm run build:renderer && electron-builder",
    "build:renderer": "cd renderer && npm run build",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "cd ../core && node-gyp rebuild",
    "build:engine": "node ../scripts/build-engine.js",
    "test:engine": "python -m unittest discover -s ../tests/engine -p \"test_*.py\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.8",
    "node-addon-api": "^8.9.2",
    "node-machine-id": "^1.1.12",
    "stripe": "^15.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "41.10.7",
    "electron-builder": "^26.17.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.lazaruscore.app",
    "productName": "Lazarus Core",
    "copyright": "Copyright (c) 2025-2026 Lazarus Core",
    "icon": "assets/icons/icon",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/main/ipc/**/*.py"
    ],
    "extraResources": [
      {
        "from": "engine-bin",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-${target}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "jolu-bot",
      "repo": "Lazarus-Core",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    },
    "electronVersion": "41.10.7",
    "directories": {
      "output": "dist-build"
    },
    "files": [
      "main/**/*",
      "renderer/dist/**/*",
      "assets/**/*",
      "package.json",
      "!**/main/ipc/photorec_win.exe",
      "!**/__pycache__/**"
    ],
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "compression": "normal"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
